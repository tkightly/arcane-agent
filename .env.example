# From the manager: Environments -> Add -> Edge, then copy the agent token.
AGENT_TOKEN=changeme

# Optional. Defaults to the manager's Edge entrypoint on docker-mgmt.
# MANAGER_API_URL=https://arcane.internal.taucetifive.com:9553

# Optional. Host directory for Git-synced projects; defaults to /opt/stacks.
# Use another path if /opt/stacks already holds app data (as on docker-ext).
# PROJECTS_PATH=/opt/stacks
